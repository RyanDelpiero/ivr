            { id: 9, date: "2026-07-21", greeting: "", layanan: "1. Halo / Prabayar", bahasa: "", tier: "Diamond / Platinum", step: "2. Nomor yang berbeda", detail: "Pelanggan prioritas bebas panggilan biaya Rp.300,-", result: "Passed", desc: "", propose: "" },
            { id: 10, date: "2026-07-27", greeting: "", layanan: "2. IndiHome/Eznet", bahasa: "", tier: "Reguler / Other", step: "1. Informasi dan Registrasi", detail: "Informasi dan registrasi pendaftaran IndiHome", result: "Passed", desc: "Telpon terputus, karena pulsa pelanggan tidak mencukupi.", propose: "" },
            { id: 11, date: "2026-07-20", greeting: "", layanan: "2. IndiHome/Eznet", bahasa: "", tier: "Reguler / Other", step: "2. Pengaduan Layanan", detail: "Laporan gangguan teknis IndiHome", result: "Passed", desc: "Telpon terputus, karena pulsa pelanggan tidak mencukupi.", propose: "perlu ditambahkan Voice Feedback untuk pelanggan yang tidak pulsa tidak mencukupi" }
        ];

        // Generate sample dates for items
        for (let i = 12; i <= 40; i++) {
            const dayOffset = i % 15;
            const dateStr = `2026-07-${(27 - dayOffset).toString().padStart(2, '0')}`;
            initialDataset.push({
                id: i,
                date: dateStr,
                greeting: "",
                layanan: i % 3 === 0 ? "2. IndiHome/Eznet" : "1. Halo / Prabayar",
                bahasa: "Bahasa",
                tier: i % 2 === 0 ? "Reguler / Other" : "Diamond / Platinum",
                step: `Menu Skenario Test #${i}`,
                detail: `Verifikasi navigasi tombol ${i % 9} -> Pilihan sub-menu`,
                result: i <= 25 ? "Passed" : "Pending",
                desc: i === 15 ? "Ekspektasi: Harusnya terdapat wording peringatan pulsa" : "",
                propose: i === 15 ? "Tambahkan voice feedback" : ""
            });
        }

        // Load data from localStorage or initialize
        let testData = JSON.parse(localStorage.getItem('ivr_test_data')) || initialDataset;

        let statusChartInstance = null;
        let categoryChartInstance = null;

        // Save data to localStorage
        function saveData() {
            localStorage.setItem('ivr_test_data', JSON.stringify(testData));
            updateDashboard();
            renderTable();
        }

        // Switch Tabs
        function switchTab(tab) {
            document.getElementById('view-dashboard').classList.toggle('hidden', tab !== 'dashboard');
            document.getElementById('view-data-table').classList.toggle('hidden', tab !== 'data-table');
            
            document.getElementById('tab-dashboard').className = `py-4 text-sm font-medium flex items-center gap-2 ${tab === 'dashboard' ? 'tab-active' : 'text-slate-500 hover:text-slate-700'}`;
            document.getElementById('tab-data-table').className = `py-4 text-sm font-medium flex items-center gap-2 ${tab === 'data-table' ? 'tab-active' : 'text-slate-500 hover:text-slate-700'}`;
            
            if (tab === 'dashboard') updateDashboard();
            if (tab === 'data-table') renderTable();
        }

        // Update Metrics & Charts
        function updateDashboard() {
            const total = testData.length;
            const passed = testData.filter(d => d.result === 'Passed').length;
            const failed = testData.filter(d => d.result === 'Failed').length;
            const pending = testData.filter(d => d.result === 'Pending' || !d.result || d.result === 'Not Tested').length;

            document.getElementById('metric-total').innerText = total;
            document.getElementById('metric-passed').innerText = passed;
            document.getElementById('metric-passed-pct').innerText = total ? `${((passed/total)*100).toFixed(1)}% dari total` : '0%';
            document.getElementById('metric-failed').innerText = failed;
            document.getElementById('metric-failed-pct').innerText = total ? `${((failed/total)*100).toFixed(1)}% dari total` : '0%';
            document.getElementById('metric-pending').innerText = pending;
            document.getElementById('metric-pending-pct').innerText = total ? `${((pending/total)*100).toFixed(1)}% dari total` : '0%';
            
            document.getElementById('total-badge').innerText = total;

            // Render Status Chart (Pie)
            const ctxPie = document.getElementById('statusChart').getContext('2d');
            if (statusChartInstance) statusChartInstance.destroy();
            statusChartInstance = new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Passed', 'Failed', 'Pending'],
                    datasets: [{
                        data: [passed, failed, pending],
                        backgroundColor: ['#10b981', '#f43f5e', '#f59e0b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // Render Category Chart (Bar)
            const ctxBar = document.getElementById('categoryChart').getContext('2d');
            if (categoryChartInstance) categoryChartInstance.destroy();
            categoryChartInstance = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: ['Halo / Prabayar', 'IndiHome / Eznet'],
                    datasets: [
                        {
                            label: 'Passed',
                            data: [
                                testData.filter(d => d.layanan.includes('Halo') && d.result === 'Passed').length,
                                testData.filter(d => d.layanan.includes('IndiHome') && d.result === 'Passed').length
                            ],
                            backgroundColor: '#10b981'
                        },
                        {
                            label: 'Pending / Issue',
                            data: [
                                testData.filter(d => d.layanan.includes('Halo') && d.result !== 'Passed').length,
                                testData.filter(d => d.layanan.includes('IndiHome') && d.result !== 'Passed').length
                            ],
                            backgroundColor: '#f59e0b'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // Render Issue Table
            const issueBody = document.getElementById('issue-table-body');
            issueBody.innerHTML = '';
            const issues = testData.filter(d => d.desc || d.propose);
            
            if (issues.length === 0) {
                issueBody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-slate-400">Tidak ada temuan masalah atau usulan perbaikan tercatat.</td></tr>`;
            } else {
                issues.forEach((item, idx) => {
                    const tr = document.createElement('tr');
                    tr.className = idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60';
                    tr.innerHTML = `
                        <td class="py-2.5 px-4 text-center font-medium text-slate-500">${idx + 1}</td>
                        <td class="py-2.5 px-4 font-medium text-slate-700">${item.layanan || '-'} <br><span class="text-[10px] text-slate-400">${item.tier || ''}</span></td>
                        <td class="py-2.5 px-4 font-semibold text-slate-800">${item.step}</td>
                        <td class="py-2.5 px-4 text-rose-700 bg-rose-50/50 rounded">${item.desc || '-'}</td>
                        <td class="py-2.5 px-4 text-sky-800 bg-sky-50/50 rounded">${item.propose || '-'}</td>
                        <td class="py-2.5 px-4 text-center">${getStatusBadge(item.result)}</td>
                    `;
                    issueBody.appendChild(tr);
                });
            }
            lucide.createIcons();
        }

        // Toggle Sort Date Header Click
        function toggleSortDate() {
            const sortSelect = document.getElementById('sort-date');
            sortSelect.value = sortSelect.value === 'DESC' ? 'ASC' : 'DESC';
            renderTable();
        }

        // Render Interactive Main Table with Sort & Filter
        function renderTable() {
            const body = document.getElementById('main-table-body');
            body.innerHTML = '';

            const search = document.getElementById('search-input').value.toLowerCase();
            const filterRes = document.getElementById('filter-result').value;
            const filterLay = document.getElementById('filter-layanan').value;
            const sortDateDir = document.getElementById('sort-date').value;

            // Filter logic
            let filtered = testData.filter(item => {
                const matchSearch = (item.step + item.detail + item.desc + item.propose).toLowerCase().includes(search);
                const matchRes = filterRes === 'ALL' || item.result === filterRes || (filterRes === 'Pending' && item.result !== 'Passed' && item.result !== 'Failed');
                const matchLay = filterLay === 'ALL' || item.layanan.includes(filterLay.replace('1. ', '').replace('2. ', ''));
                return matchSearch && matchRes && matchLay;
            });

            // Sort logic by Date
            filtered.sort((a, b) => {
                const dateA = new Date(a.date || '1970-01-01');
                const dateB = new Date(b.date || '1970-01-01');
                return sortDateDir === 'DESC' ? dateB - dateA : dateA - dateB;
            });

            document.getElementById('filtered-count').innerText = filtered.length;

            if (filtered.length === 0) {
                body.innerHTML = `<tr><td colspan="10" class="py-8 text-center text-slate-400">Data tidak ditemukan.</td></tr>`;
                return;
            }

            filtered.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.className = index % 2 === 0 ? 'bg-white hover:bg-slate-50' : 'bg-slate-50/40 hover:bg-slate-50';
                tr.innerHTML = `
                    <td class="py-3 px-3 text-center text-slate-500 font-medium">${index + 1}</td>
                    <td class="py-3 px-3 whitespace-nowrap font-medium text-slate-700 bg-amber-50/30 rounded">${item.date || '-'}</td>
                    <td class="py-3 px-3 font-medium text-slate-700">${item.layanan || '-'}</td>
                    <td class="py-3 px-3 text-slate-500">${item.tier || '-'}</td>
                    <td class="py-3 px-3 font-semibold text-slate-800">${item.step}</td>
                    <td class="py-3 px-3 text-slate-600 max-w-xs truncate" title="${item.detail}">${item.detail || '-'}</td>
                    <td class="py-3 px-3 text-center">${getStatusBadge(item.result)}</td>
                    <td class="py-3 px-3 text-rose-600 max-w-xs truncate" title="${item.desc}">${item.desc || '-'}</td>
                    <td class="py-3 px-3 text-sky-700 max-w-xs truncate" title="${item.propose}">${item.propose || '-'}</td>
                    <td class="py-3 px-3 text-center">
                        <button onclick="editTestCase(${item.id})" class="p-1.5 text-slate-600 hover:text-sky-600 hover:bg-sky-50 rounded transition" title="Edit">
                            <i data-lucide="edit-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                `;
                body.appendChild(tr);
            });
            lucide.createIcons();
        }

        function getStatusBadge(result) {
            if (result === 'Passed') {
                return `<span class="px-2 py-0.5 text-[10px] font-bold bg-emerald-100 text-emerald-800 rounded-full border border-emerald-300">Passed</span>`;
            } else if (result === 'Failed') {
                return `<span class="px-2 py-0.5 text-[10px] font-bold bg-rose-100 text-rose-800 rounded-full border border-rose-300">Failed</span>`;
            } else {
                return `<span class="px-2 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded-full border border-amber-300">Pending</span>`;
            }
        }

        // Export Function to Excel (.xlsx) using SheetJS
        function exportToExcel(type = 'all') {
            let exportData = [];
            
            if (type === 'issues') {
                const issues = testData.filter(d => d.desc || d.propose);
                exportData = issues.map((item, index) => ({
                    "No": index + 1,
                    "Tanggal": item.date || "-",
                    "Jenis Layanan": item.layanan || "-",
                    "Tier": item.tier || "-",
                    "Menu / Step": item.step || "-",
                    "Deskripsi Issue": item.desc || "-",
                    "Usulan Solusi": item.propose || "-",
                    "Status": item.result || "Pending"
                }));
            } else {
                exportData = testData.map((item, index) => ({
                    "No": index + 1,
                    "Tanggal Testing": item.date || "-",
                    "Jenis Layanan": item.layanan || "-",
                    "Tier Pelanggan": item.tier || "-",
                    "Menu / Step IVR": item.step || "-",
                    "Detail Navigasi": item.detail || "-",
                    "Hasil Test Case": item.result || "Pending",
                    "Deskripsi Temuan / Issue": item.desc || "-",
                    "Rekomendasi / Propose": item.propose || "-"
                }));
            }

            // Create worksheet and workbook
            const worksheet = XLSX.utils.json_to_sheet(exportData);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, type === 'issues' ? "Hasil Temuan Issue" : "Data Pengetesan IVR");

            // Save file
            const filename = type === 'issues' ? `Laporan_Temuan_Issue_IVR_${new Date().toISOString().split('T')[0]}.xlsx` : `Laporan_Hasil_Testing_IVR_${new Date().toISOString().split('T')[0]}.xlsx`;
            XLSX.writeFile(workbook, filename);
        }

        // Modal Operations
        function openAddModal() {
            document.getElementById('modal-title').innerText = 'Form Catat Hasil Test Baru';
            document.getElementById('form-id').value = '';
            document.getElementById('form-date').value = new Date().toISOString().split('T')[0];
            document.getElementById('form-result').value = 'Passed';
            document.getElementById('form-layanan').value = '1. Halo / Prabayar';
            document.getElementById('form-tier').value = 'Reguler / Other';
            document.getElementById('form-step').value = '';
            document.getElementById('form-detail').value = '';
            document.getElementById('form-desc').value = '';
            document.getElementById('form-propose').value = '';
            
            document.getElementById('test-modal').classList.remove('hidden');
        }

        function editTestCase(id) {
            const item = testData.find(d => d.id === id);
            if (!item) return;

            document.getElementById('modal-title').innerText = 'Edit Results & Feedback Test Case';
            document.getElementById('form-id').value = item.id;
            document.getElementById('form-date').value = item.date || new Date().toISOString().split('T')[0];
            document.getElementById('form-result').value = item.result || 'Passed';
            document.getElementById('form-layanan').value = item.layanan || '';
            document.getElementById('form-tier').value = item.tier || '';
            document.getElementById('form-step').value = item.step || '';
            document.getElementById('form-detail').value = item.detail || '';
            document.getElementById('form-desc').value = item.desc || '';
            document.getElementById('form-propose').value = item.propose || '';

            document.getElementById('test-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('test-modal').classList.add('hidden');
        }

        function saveTestCase(e) {
            e.preventDefault();
            const idVal = document.getElementById('form-id').value;
            
            const newItem = {
                id: idVal ? parseInt(idVal) : Date.now(),
                date: document.getElementById('form-date').value,
                result: document.getElementById('form-result').value,
                layanan: document.getElementById('form-layanan').value,
                tier: document.getElementById('form-tier').value,
                step: document.getElementById('form-step').value,
                detail: document.getElementById('form-detail').value,
                desc: document.getElementById('form-desc').value,
                propose: document.getElementById('form-propose').value
            };

            if (idVal) {
                const idx = testData.findIndex(d => d.id === parseInt(idVal));
                if (idx !== -1) testData[idx] = newItem;
            } else {
                testData.unshift(newItem);
            }

            saveData();
            closeModal();
        }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(testData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `IVR_Testing_Backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function resetData() {
            if (confirm("Apakah Anda yakin ingin mengembalikan data ke kondisi awal dari file Excel?")) {
                testData = initialDataset;
                saveData();
            }
        }

        // Initialize App
        window.onload = function() {
            lucide.createIcons();
            updateDashboard();
            renderTable();
        };
    </script>
</body>
</html>
